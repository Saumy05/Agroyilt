# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration*
MONGODB_URI=


# JWT Configuration
JWT_SECRET=your-sut-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refreshcret-change-this-in-production
JWT_REFRESH_EXPIRE=30d


# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173


# Realtime & Queue Configuration
# Redis Configuration - Set REDIS_ENABLED=true to use Redis caching
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
TOKEN_QUEUE_DEFAULT_AVG_MINUTES=15
TOKEN_QUEUE_MAX_RECALLS=2
QUEUE_RECALC_CRON=*/5 * * * *
QUEUE_NOSHOW_CRON=*/10 * * * *

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=h
CLOUDINARY_API_KEY=638952
CLOUDINARY_API_SECRET=bYvT1fWtM


# Email Configuration (if using email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Appzeto <noreply@Homster.com>"


# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# Admin registration safeguard
ADMIN_REGISTRATION_CODE=secure-code-to-create-admins
ADMIN_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com


# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Password reset configuration
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173


FIREBASE_SERVICE_ACCOUNT_PATH=

FIREBASE_CONFIG=





# ========================================
# SMS INDIA HUB CONFIGURATION
# ========================================
# Get these from your SMS India Hub account
SMS_INDIA_HUB_USERNAME=

SMS_INDIA_HUB_API_KEY=

SMS_INDIA_HUB_SENDER_ID=

SMS_INDIA_HUB_DLT_TEMPLATE_ID=
# DLT template ID for the "account approved" SMS sent to farmers, vendors and workers.
# Register this exact text with the provider first (each {#var#} is a variable):
#   Dear {#var#}, your AgroYilt {#var#} account has been approved. You can now log in to the app with your MPIN. - AgroYilt
# Left empty, the approval SMS is skipped (the in-app, push and email notices still go out).
SMS_APPROVAL_DLT_TEMPLATE_ID=
# ========================================
# OTP CONFIGURATION (PRODUCTION VALUES)
# ========================================
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
# Set to 'true' to use default OTP (123456) for testing (development only)
# Set to 'false' in production!
USE_DEFAULT_OTP=true 